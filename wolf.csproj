<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <VersionPrefix>1.1.0</VersionPrefix>
    <Authors>Wolfgang Ziegler</Authors>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <AssemblyName>wolf</AssemblyName>
    <RootNamespace>Wolf</RootNamespace>
    <OutputType>Exe</OutputType>
    <PackageId>wolf</PackageId>
    <PackageProjectUrl>https://github.com/z1c0/wolf</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="wolf.Tests\**" />
    <EmbeddedResource Remove="wolf.Tests\**" />
    <None Remove="wolf.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="wolf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
  </ItemGroup>

</Project>
