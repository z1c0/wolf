<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\wolf.csproj" />
  </ItemGroup>

  <!-- The sample posts from the repo root and their expected output. -->
  <ItemGroup>
    <None Include="..\posts\**\*" Exclude="..\posts\*.json;..\posts\*\*.html" LinkBase="SamplePosts" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Expected\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
